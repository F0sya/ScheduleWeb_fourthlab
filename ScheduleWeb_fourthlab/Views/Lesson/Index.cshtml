@model IEnumerable<ScheduleWeb.Models.Lesson>

@{
    ViewData["Title"] = "Розклад занять";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">📅 Розклад занять</h2>
    <div>
        <a asp-action="Dictionaries" class="btn btn-outline-primary shadow-sm rounded-pill px-4">
            📚 Словники (Групи/Викладачі)
        </a>
    </div>
</div>

<form method="get" asp-action="Index" class="mb-4 bg-light p-4 rounded-4 shadow-sm border-0">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Дата:</label>
            <input type="text" name="searchDate" class="form-control rounded-3" placeholder="дд.мм.рррр або 'сьогодні'" value="@ViewBag.SearchDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Предмет:</label>
            <input type="text" name="searchSubject" class="form-control rounded-3" placeholder="Назва предмета..." value="@ViewBag.SearchSubject" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Викладач:</label>
            <input type="text" name="searchTeacher" class="form-control rounded-3" placeholder="ПІБ викладача..." value="@ViewBag.SearchTeacher" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Група:</label>
            <input type="text" name="searchGroup" class="form-control rounded-3" placeholder="Назва групи..." value="@ViewBag.SearchGroup" />
        </div>
        
        <div class="col-md-2">
            <label class="form-label fw-semibold">Час:</label>
            <input type="text" name="searchTime" class="form-control rounded-3" placeholder="Напр. 08:30" value="@ViewBag.SearchTime" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Аудиторія:</label>
            <input type="text" name="searchRoom" class="form-control rounded-3" placeholder="Номер..." value="@ViewBag.SearchRoom" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-semibold">Тиждень:</label>
            <input type="number" name="searchWeek" class="form-control rounded-3" placeholder="1-18" value="@ViewBag.SearchWeek" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Тип заняття:</label>
            <select name="searchLessonType" class="form-select rounded-3">
                <option value="">Усі типи</option>
                <option value="Лекція" selected="@(ViewBag.SearchLessonType == "Лекція")">Лекція</option>
                <option value="Практика" selected="@(ViewBag.SearchLessonType == "Практика")">Практика</option>
                <option value="Лабораторна" selected="@(ViewBag.SearchLessonType == "Лабораторна")">Лабораторна</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm px-4 rounded-pill transition-all hover-scale">
                🔍 Знайти
            </button>
            <a asp-action="Index" class="btn btn-secondary flex-grow-1 shadow-sm px-4 rounded-pill transition-all hover-scale">
                🔄 Очистити
            </a>
        </div>
    </div>
</form>

<div class="mb-4 d-flex justify-content-end">
    <form asp-action="DeleteDuplicates" method="post" class="m-0">
        <button type="submit" id="btn-delete-duplicates" class="btn btn-outline-danger shadow-sm px-4 rounded-pill transition-all hover-scale" title="Видалити повні дублікати">
            🗑️ Видалити дублікати
        </button>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="bg-primary text-white">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Дата</th>
                    <th>Час</th>
                    <th>Предмет</th>
                    <th>Аудиторія</th>
                    <th>Викладач</th>
                    <th>Група</th>
                    <th class="text-center">Тип</th>
                    <th class="pe-4 text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-light text-dark border">@item.Id</span>
                        </td>
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge bg-light text-dark border">@item.Time</span></td>
                        <td class="fw-semibold">@item.Subject</td>
                        <td>@item.Room</td>
                        <td>@item.Teacher?.FullName</td>
                        <td>@string.Join(", ", item.Groups.Select(g => g.Name))</td>
                        <td class="text-center">
                            @if (item.LessonType == "Лекція") { <span class="badge bg-info text-white">Лекція</span> }
                            else if (item.LessonType == "Практика") { <span class="badge bg-warning text-dark">Практика</span> }
                            else { <span class="badge bg-secondary">@item.LessonType</span> }
                        </td>
                        <td class="pe-4 text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    ✏️ Редагувати
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити це заняття?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        🗑️ Видалити
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 align-items-center mb-5">
    <a asp-action="Create" class="btn btn-success btn-lg shadow-sm px-5 rounded-pill transition-all hover-scale">
        ➕ Додати заняття
    </a>
    
    <a asp-action="Export" 
       asp-route-searchDate="@ViewBag.SearchDate" 
       asp-route-searchSubject="@ViewBag.SearchSubject" 
       asp-route-searchTeacher="@ViewBag.SearchTeacher" 
       asp-route-searchGroup="@ViewBag.SearchGroup" 
       asp-route-searchTime="@ViewBag.SearchTime" 
       asp-route-searchRoom="@ViewBag.SearchRoom" 
       asp-route-searchWeek="@ViewBag.SearchWeek" 
       asp-route-searchLessonType="@ViewBag.SearchLessonType" 
       class="btn btn-outline-success btn-lg shadow-sm px-4 rounded-pill">
        📥 Експорт в Excel
    </a>

    <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
        <input type="file" name="file" class="form-control form-control-sm rounded-pill" style="width: 250px;" required />
        <button type="submit" class="btn btn-outline-dark btn-lg shadow-sm px-4 rounded-pill">
            📤 Імпорт з Excel
        </button>
    </form>
</div>

<style>
    .hover-scale:hover {
        transform: scale(1.03);
        transition: all 0.2s ease-in-out;
    }
    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>